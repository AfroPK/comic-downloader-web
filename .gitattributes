# Normalize line endings: store LF in the repo, check out LF everywhere.
* text=auto eol=lf

# Never touch binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.cbz binary
*.cbr binary
*.zip binary

# Explicit line-ending rules for scripts/config
*.sh  text eol=lf
*.js  text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md  text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
